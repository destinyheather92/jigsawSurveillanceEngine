{
  "name": "jigsaw-surveillance-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch app.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:create": "tsx prisma/ensure-sqlite.ts",
    "db:migrate": "npm run db:create && prisma migrate dev --skip-generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-check": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^6.0.1",
    "pure-rand": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
