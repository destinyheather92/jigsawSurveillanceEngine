generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scenario {
  id          String @id @default(cuid())
  title       String
  description String
  choices     String
}

model Attempt {
  id            String   @id @default(cuid())
  scenarioId    String
  choice        String
  outcome       String
  survivalScore Int
  moralScore    Int
  message       String
  createdAt     DateTime @default(now())
}
